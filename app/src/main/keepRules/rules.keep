# G5 -- keep rules do :app. Consumidas pelo AGP a partir de src/main/keepRules.
# Cada bloco existe porque algo e resolvido em runtime (reflexao/serializacao) e o R8
# nao consegue provar o uso estaticamente.

# --- kotlinx.serialization -----------------------------------------------------------
# O serializer de cada @Serializable e obtido por reflexao no Companion.
-keepattributes *Annotation*, InnerClasses, Signature, RuntimeVisibleAnnotations
-dontnote kotlinx.serialization.**

-if @kotlinx.serialization.Serializable class **
-keepclassmembers class <1> {
    static <1>$Companion Companion;
}
-if @kotlinx.serialization.Serializable class ** {
    static **$* *;
}
-keepclassmembers class <2>$<3> {
    kotlinx.serialization.KSerializer serializer(...);
}
-keepclasseswithmembers class ** {
    @kotlinx.serialization.Serializable <fields>;
}
-keep,includedescriptorclasses class com.desafiomercadobitcoin.**$$serializer { *; }

# --- Ktor ----------------------------------------------------------------------------
# Plugins e o roteamento type-safe (@Resource) sao resolvidos por atributos/reflexao.
-keep class io.ktor.** { *; }
-keepclassmembers class io.ktor.** { volatile <fields>; }
-keep @io.ktor.resources.Resource class * { *; }
-dontwarn io.ktor.**
-dontwarn org.slf4j.**

# --- Koin ----------------------------------------------------------------------------
# `get()` resolve por tipo em runtime; construtores injetados nao podem ser removidos.
-keep class org.koin.** { *; }
-keepclassmembers class * {
    public <init>(...);
}
-dontwarn org.koin.**

# --- @Parcelize / SavedStateHandle ----------------------------------------------------
# O CREATOR e gerado e lido reflexivamente pelo framework ao restaurar estado.
-keep class * implements android.os.Parcelable {
    public static final ** CREATOR;
}

# --- Coroutines ----------------------------------------------------------------------
-keepclassmembers class kotlinx.coroutines.** { volatile <fields>; }
-dontwarn kotlinx.coroutines.**

# --- Coil ----------------------------------------------------------------------------
# O fetcher de rede e descoberto por ServiceLoader e o ImageLoader resolve componentes
# por tipo em runtime; o R8 nao consegue provar esses usos estaticamente.
-keep class coil3.network.ktor3.internal.KtorNetworkFetcherServiceLoaderTarget { *; }
-keep,allowobfuscation interface coil3.util.FetcherServiceLoaderTarget
-keep class * implements coil3.util.FetcherServiceLoaderTarget { *; }
-keep class * implements coil3.util.DecoderServiceLoaderTarget { *; }
-dontwarn coil3.**

# --- Navigation 3 --------------------------------------------------------------------
# A pilha e serializada/desserializada por chave; os decoradores e o entryProvider
# resolvem entradas por tipo.
-keep class androidx.navigation3.** { *; }
-keep class androidx.lifecycle.viewmodel.navigation3.** { *; }
-dontwarn androidx.navigation3.**

# --- Chaves de rota @Serializable ------------------------------------------------------
# `rememberNavBackStack` persiste a pilha pelo serializer de cada chave: perder o nome do
# tipo ou o Companion quebra a restauracao apos morte de processo.
-keep class com.desafiomercadobitcoin.presentation.navigation.** { *; }
-keepclassmembers class com.desafiomercadobitcoin.presentation.navigation.** {
    public static ** INSTANCE;
    kotlinx.serialization.KSerializer serializer(...);
}
