root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120

# Composables sao PascalCase por convencao do Compose; sem esta excecao o
# ktlint_official reprova codigo correto (D5). Nao e enfraquecimento da regra:
# e a configuracao da regra para o dialeto do projeto.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
